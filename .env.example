# Konfigurasi Lingkungan HargaBekas (Salin file ini menjadi .env)
# JANGAN pernah menulis API key secara langsung di kode sumber atau frontend.

# Mode Damage Analyzer: "claude" (default jika API key terisi), "local_yolo", atau "manual"
DAMAGE_ANALYZER_MODE=claude

# API Key Anthropic untuk analisis foto kerusakan menggunakan Claude Vision API
ANTHROPIC_API_KEY=
CLAUDE_VISION_MODEL=claude-3-5-sonnet-20241022

# Batas Unggahan Foto Inspeksi
MAX_UPLOAD_MB=8
MAX_PHOTOS_PER_REQUEST=10
FLASK_SECRET_KEY=hargabekas-inspection-editorial-2025
